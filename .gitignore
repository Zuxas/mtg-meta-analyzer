# Daily scraper logs
logs/

# Database (can get large, regenerate by running scraper)
data/*.db
data/*.db-shm
data/*.db-wal

# Raw data dumps
data/*.json
data/*.csv

# Local config (DB path may differ per machine)
config.ini

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/

# VS Code (commit workspace settings, ignore user-specific files)
.vscode/*
!.vscode/settings.json

# Claude Code (commit project permissions, ignore session/cache data)
.claude/*
!.claude/settings.json

# Windows
Thumbs.db
Desktop.ini

# Scratch / debug files
debug_response.html
mtgdecks.net homepage.txt

# Local roadmap (personal planning doc, not for repo)
ROADMAP.md
