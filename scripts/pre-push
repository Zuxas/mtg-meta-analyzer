#!/usr/bin/env bash
# ────────────────────────────────────────────────────────────────────
# pre-push hook — scan staged push for sensitive content
#
# Install:  cp pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# Bypass:   git push --no-verify   (only when you know what you're doing)
#
# Customize the PERSONAL pattern below for your project. Everything else
# should be left alone unless you know you need it.
# ────────────────────────────────────────────────────────────────────
set -u

# ── Patterns ────────────────────────────────────────────────────────

# Personal identifiers and machine paths are PRIVATE, so they are not in
# this file. They live in an untracked file next to the installed hook:
#   $(git rev-parse --git-common-dir)/hooks/pre-push.local
# (copy scripts/pre-push.local.example there and fill it in). CI supplies
# the same file from the PRE_PUSH_LOCAL secret. PRE_PUSH_LOCAL_FILE
# overrides the location. Without it, only the generic patterns run.
PERSONAL=''
PATHS='/home/[a-z]+/\.ssh/id_'
LOCAL_FILE="${PRE_PUSH_LOCAL_FILE:-$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-push.local}"
if [ -f "$LOCAL_FILE" ]; then
    # shellcheck source=/dev/null
    . "$LOCAL_FILE"
else
    echo "pre-push: no $LOCAL_FILE; scanning for secrets only, not personal names or paths." >&2
fi

# Secrets & credentials — generic, don't edit
SECRETS='sk-[a-zA-Z0-9]{20,}'
SECRETS="${SECRETS}|sk-ant-[a-zA-Z0-9_-]{20,}"
SECRETS="${SECRETS}|(ANTHROPIC|OPENAI|DISCORD|GITHUB|HUGGINGFACE|SLACK)_(API_KEY|TOKEN)[[:space:]]*=[[:space:]]*[^\$\{[:space:]]"
SECRETS="${SECRETS}|Bearer[[:space:]]+[a-zA-Z0-9_-]{20,}"
SECRETS="${SECRETS}|Authorization:[[:space:]]*Bearer"
SECRETS="${SECRETS}|ya29\.[a-zA-Z0-9_-]+"
SECRETS="${SECRETS}|ghp_[a-zA-Z0-9]{30,}"
SECRETS="${SECRETS}|gho_[a-zA-Z0-9]{30,}"
SECRETS="${SECRETS}|AKIA[0-9A-Z]{16}"
SECRETS="${SECRETS}|-----BEGIN (RSA|OPENSSH|EC|DSA|PRIVATE) "

# Session cookies / browser session artifacts
COOKIES='cookies\.txt|__Secure-1PSID|__Secure-3PSID|SAPISID|APISID|SSID|HSID'

# Combined
PATTERN="${SECRETS}|${COOKIES}|${PATHS}"
[ -n "$PERSONAL" ] && PATTERN="${PERSONAL}|${PATTERN}"

# ── Push-range detection ────────────────────────────────────────────

z40=0000000000000000000000000000000000000000
exit_code=0
# Not scanned: the hook itself (it holds the patterns by design -- keep this
# exception to the one file) and generated lockfiles.
EXCLUDES=(':(exclude)*pre-push' ':(exclude)*.lock' ':(exclude)*package-lock.json')

# Scan what is being PUSHED, read from git objects -- never the working tree,
# which can hold an older or uncommitted copy. Every commit in the push is
# scanned (a secret added then removed is still in the pushed history), but
# only the lines each commit adds, so text already on the remote is not
# re-flagged.
added_lines() {   # args = rev range; prints path:line:text for each added line
    git log -p -U0 --no-color --no-ext-diff --format= "$@" -- . "${EXCLUDES[@]}" 2>/dev/null | awk '
        /^\+\+\+ / { f = substr($0, 7); next }
        /^@@/        { match($0, /\+[0-9]+/); n = substr($0, RSTART + 1, RLENGTH - 1); next }
        /^\+/        { print f ":" n ":" substr($0, 2); n++ }'
}

while read -r local_ref local_sha remote_ref remote_sha; do
    # Skip deletions
    [ "$local_sha" = "$z40" ] && continue

    if [ "$remote_sha" = "$z40" ]; then
        # New branch: every commit the remote doesn't have yet.
        hits=$(added_lines "$local_sha" --not --remotes | grep -iE "$PATTERN")
    else
        hits=$(added_lines "$remote_sha..$local_sha" | grep -iE "$PATTERN")
    fi
    [ -z "$hits" ] && continue

    exit_code=1
    # PRE_PUSH_QUIET (set in CI, whose logs are public): line numbers only,
    # so a hit doesn't publish what it caught.
    printf '%s\n' "$hits" | awk -F: -v quiet="${PRE_PUSH_QUIET:-}" '
        $1 != f { f = $1; c = 0; printf "\n❌  %s\n", f }
        { c++
          if (c <= 5) {
              if (quiet != "") printf "    line %s\n", $2
              else { t = $0; sub(/^[^:]*:/, "", t); printf "    %s\n", t }
          } else if (c == 6) print "    ... and more" }'
done

# ── Result ──────────────────────────────────────────────────────────

if [ "$exit_code" -ne 0 ]; then
    echo ""
    echo "═══════════════════════════════════════════════════════════════"
    echo " Push blocked: potential sensitive content detected."
    echo ""
    echo " For each match above, either:"
    echo "   1. Scrub the content and amend your commit, or"
    echo "   2. Move the file to a private repo, or"
    echo "   3. Confirm it's intentional and re-run with --no-verify"
    echo ""
    echo " If the pattern list is flagging something that's actually safe,"
    echo " tune PERSONAL and PATHS at the top of .git/hooks/pre-push."
    echo "═══════════════════════════════════════════════════════════════"
    exit 1
fi

exit 0
